---
import { ClientRouter } from 'astro:transitions';
import CookieConsent from '../components/CookieConsent';
import LanguagePicker from '../components/LanguagePicker';
import PrimaryNav from '../components/PrimaryNav.astro';
import { locales, localeLabels, localeRegionLine, type Locale } from '../i18n/config';
import { languageModalCopy } from '../i18n/language-modal';
import { legalFooterLabels, legalFooterPublicationNote } from '../i18n/legal-nav';
import { localeEquivalentHref } from '../i18n/locale-hrefs';
import { headerBookingCta } from '../i18n/nav';
import { resolveBookingCta } from '../i18n/booking-links';
import { href, iaKeyFromPath, isBlogPath, isBookingPath, type IaKey } from '../i18n/route-registry';
import { blogPublic } from '../i18n/site-features';
import '../styles/app.css';

interface Props {
	lang: Locale;
	title: string;
	description: string;
	ogImage?: string;
	/** Marketing home: translucent header over hero + full-bleed main. */
	shell?: 'default' | 'marketing';
}

const { lang, title, description, ogImage, shell = 'default' } = Astro.props;
const footerLegal = legalFooterLabels(lang);
const footerNote = legalFooterPublicationNote(lang);

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const parts = pathname.split('/').filter(Boolean);
const pathWithinLocale = parts.length > 1 ? `${parts.slice(1).join('/')}/` : '';

let currentIaKey: IaKey = 'home';
let useLegacyLocalePaths = false;

if (parts.length <= 1) {
	currentIaKey = 'home';
} else if (parts[0] !== lang) {
	useLegacyLocalePaths = true;
} else if (parts[1] === 'blog' && parts.length > 2) {
	currentIaKey = 'blog';
	useLegacyLocalePaths = true;
} else if (parts[1] === 'blog') {
	currentIaKey = 'blog';
} else {
	const ik = iaKeyFromPath(lang, parts[1]);
	if (ik) currentIaKey = ik;
	else useLegacyLocalePaths = true;
}

const siteRoot = Astro.site ? new URL(Astro.site) : Astro.url;
const origin = siteRoot.origin;

function pageUrl(locale: string) {
	const loc = locale as Locale;
	if (!useLegacyLocalePaths) {
		return `${origin}${href(loc, currentIaKey)}`;
	}
	return pathWithinLocale
		? `${origin}/${loc}/${pathWithinLocale.replace(/\/+$/, '')}/`
		: `${origin}/${loc}/`;
}

function ogLocale(code: Locale): string {
	if (code === 'ca') return 'ca_ES';
	if (code === 'fr') return 'fr_FR';
	if (code === 'en') return 'en_GB';
	return 'es_ES';
}

const bookingRoute = isBookingPath(pathname);
const blogRoute = isBlogPath(pathname);
const robots = bookingRoute || (!blogPublic && blogRoute) ? 'noindex,follow' : undefined;
const ogDefault = ogImage ?? new URL('/og-placeholder.svg', siteRoot).href;

const bookingCta = resolveBookingCta(lang);
const langPickerItems = locales.map((code) => ({
	locale: code,
	label: localeLabels[code],
	region: localeRegionLine[code],
	href: localeEquivalentHref(code, {
		currentIaKey,
		pathWithinLocale,
		useLegacyLocalePaths,
	}),
	suggested: code === 'es' || code === 'ca',
}));
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{robots ? <meta name="robots" content={robots} /> : null}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={ogLocale(lang)} />
		{locales
			.filter((code) => code !== lang)
			.map((code) => (
				<meta property="og:locale:alternate" content={ogLocale(code)} />
			))}
		<meta property="og:image" content={ogDefault} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/logo-aj.svg?v=2" />
		<link rel="shortcut icon" type="image/svg+xml" href="/logo-aj.svg?v=2" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={pageUrl(lang)} />
		{locales.map((code) => <link rel="alternate" hreflang={code} href={pageUrl(code)} />)}
		<link rel="alternate" hreflang="x-default" href={pageUrl('es')} />
		<ClientRouter />
	</head>
	<body class:list={[shell === 'marketing' ? 'site-body--marketing' : undefined]}>
		<header class="site-header" transition:animate="none">
			<div class="site-header__inner">
				<a class="site-header__logo" href={href(lang, 'home')}>
					<img
						class="site-header__logo-img"
						src="/logo.svg"
						alt=""
						width="1590"
						height="1820"
						decoding="async"
						loading="eager"
					/>
				</a>
				<div class="site-header__center">
					<a class="site-header__wordmark" href={href(lang, 'home')}>
						<img
							class="site-header__wordmark-img"
							src="/dra-jessica-tellechea.svg"
							alt="Dra. Jessica Tellechea"
							width="2928"
							height="181"
							decoding="async"
							loading="eager"
							fetchpriority="high"
						/>
					</a>
					<div class="site-header__toolbar">
						<PrimaryNav lang={lang} currentIaKey={currentIaKey} bookingCta={bookingCta} />
					</div>
				</div>
				<div class="site-header__actions">
					<a
						class="site-header__booking site-header__booking--desktop"
						href={bookingCta.href}
						target={bookingCta.external ? '_blank' : undefined}
						rel={bookingCta.external ? 'noopener noreferrer' : undefined}
					>
						{headerBookingCta[lang]}
					</a>
					<LanguagePicker
						client:load
						current={lang}
						items={langPickerItems}
						copy={languageModalCopy[lang]}
					/>
				</div>
			</div>
		</header>
		<main class:list={['site-main', shell === 'marketing' && 'site-main--bleed']}>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="site-footer__inner">
				<nav class="site-footer__legal" aria-label="Legal">
					<a href={`/${lang}/privacidad/`}>{footerLegal.privacy}</a>
					<a href={`/${lang}/cookies/`}>{footerLegal.cookies}</a>
					<a href={`/${lang}/aviso-legal/`}>{footerLegal.legalNotice}</a>
				</nav>
				<p class="site-footer__note">{footerNote}</p>
			</div>
		</footer>
		<script is:inline>
			(() => {
				const body = document.body;
				const SCROLLED_CLASS = 'site-body--scrolled';
				if (!body) return;

				const syncHeaderState = () => {
					if (window.scrollY > 0) body.classList.add(SCROLLED_CLASS);
					else body.classList.remove(SCROLLED_CLASS);
				};

				syncHeaderState();
				window.addEventListener('scroll', syncHeaderState, { passive: true });
				document.addEventListener('astro:page-load', syncHeaderState);
			})();
		</script>
		<CookieConsent client:load lang={lang} />
	</body>
</html>
