---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../i18n/config';
import { contactPageMeta } from '../../i18n/contact-page';
import ValoracionForm from '../../components/ValoracionForm.astro';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const meta = contactPageMeta[lang];
---

<BaseLayout lang={lang} title={meta.title} description={meta.intro}>
	<h1>{meta.heading}</h1>
	<p>{meta.intro}</p>
	<ValoracionForm lang={lang} />
</BaseLayout>
