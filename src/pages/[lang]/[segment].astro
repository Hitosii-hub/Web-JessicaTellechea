---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../i18n/config';
import {
	stubSegments,
	pageStubsBySegment,
	type StubSegment,
} from '../../i18n/page-stubs';
import CTAStack from '../../components/CTAStack.astro';

export function getStaticPaths() {
	const paths: { params: { lang: Locale; segment: string } }[] = [];
	for (const lang of locales) {
		for (const segment of stubSegments) {
			paths.push({ params: { lang, segment } });
		}
	}
	return paths;
}

const lang = Astro.params.lang as Locale;
const segment = Astro.params.segment as StubSegment;
const { title, heading, lead } = pageStubsBySegment[segment][lang];
const showCta = ['facial', 'corporal', 'capilar', 'criterio-medico'].includes(segment);
---

<BaseLayout lang={lang} title={title} description={lead}>
	<h1>{heading}</h1>
	<p>{lead}</p>
	{showCta ? <CTAStack lang={lang} /> : null}
	{
		segment === 'reservar-cita' ? (
			<div class="booking-embed-placeholder" data-booking-embed>
				<strong>Placeholder</strong> — aqui ira el embed o enlace profundo al proveedor de agenda (tercero).
			</div>
		) : null
	}
</BaseLayout>
