---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../i18n/config';
import { contactPageMeta } from '../../i18n/contact-page';
import ContactPage from '../../components/contact/ContactPage.astro';
import CapilarPillarPage from '../../components/capilar/CapilarPillarPage.astro';
import CorporalPillarPage from '../../components/corporal/CorporalPillarPage.astro';
import FacialPillarPage from '../../components/facial/FacialPillarPage.astro';
import TrustPage from '../../components/trust/TrustPage.astro';
import { bookingPlaceholderCta, pageStubsBySegment } from '../../i18n/page-stubs';
import { capilarPageContent } from '../../i18n/capilar-page';
import { corporalPageContent } from '../../i18n/corporal-page';
import { facialPageContent } from '../../i18n/facial-page';
import { trustPageContent } from '../../i18n/trust-page';
import { resolveBookingCta } from '../../i18n/booking-links';
import { href, iaKeyFromPath, type IaKey, segmentFor, stubRecordKeyFromIaKey } from '../../i18n/route-registry';

export function getStaticPaths() {
	const pathKeys: Exclude<IaKey, 'home' | 'blog'>[] = [
		'facial',
		'corporal',
		'capilar',
		'trust',
		'contact',
		'booking',
	];
	const paths: { params: { lang: Locale; segment: string } }[] = [];
	for (const lang of locales) {
		for (const key of pathKeys) {
			paths.push({ params: { lang, segment: segmentFor(lang, key) } });
		}
	}
	return paths;
}

const lang = Astro.params.lang as Locale;
const segment = Astro.params.segment as string;
const iaKey = iaKeyFromPath(lang, segment);
const bookingCta = resolveBookingCta(lang);

if (!iaKey) {
	return Astro.redirect(`/${lang}/`, 302);
}

let title: string;
let heading: string;
let lead: string;
let bookingBlock = false;
let facialContent = facialPageContent[lang];
let capilarContent = capilarPageContent[lang];
let corporalContent = corporalPageContent[lang];
let trustContent = trustPageContent[lang];

if (iaKey === 'contact') {
	const meta = contactPageMeta[lang];
	title = meta.title;
	heading = meta.heading;
	lead = meta.intro;
} else if (iaKey === 'facial') {
	const content = facialPageContent[lang];
	facialContent = content;
	title = content.seo.title;
	heading = content.hero.h1;
	lead = content.seo.description;
} else if (iaKey === 'corporal') {
	const content = corporalPageContent[lang];
	corporalContent = content;
	title = content.seo.title;
	heading = content.hero.h1;
	lead = content.seo.description;
} else if (iaKey === 'capilar') {
	const content = capilarPageContent[lang];
	capilarContent = content;
	title = content.seo.title;
	heading = content.hero.h1;
	lead = content.seo.description;
} else if (iaKey === 'trust') {
	const content = trustPageContent[lang];
	trustContent = content;
	title = content.seo.title;
	heading = content.hero.h1;
	lead = content.seo.description;
} else {
	const stubKey = stubRecordKeyFromIaKey(iaKey);
	if (!stubKey) {
		return Astro.redirect(`/${lang}/`, 302);
	}
	const stub = pageStubsBySegment[stubKey][lang];
	title = stub.title;
	heading = stub.heading;
	lead = stub.lead;
	bookingBlock = iaKey === 'booking';
}
---

<BaseLayout lang={lang} title={title} description={lead} shell={iaKey === 'contact' ? 'marketing' : 'default'}>
	{
		iaKey === 'contact' ? (
			<ContactPage lang={lang} />
		) : (
			<>
				{iaKey === 'facial' ? <FacialPillarPage lang={lang} content={facialContent} /> : null}
				{iaKey === 'corporal' ? <CorporalPillarPage lang={lang} content={corporalContent} /> : null}
				{iaKey === 'capilar' ? <CapilarPillarPage lang={lang} content={capilarContent} /> : null}
				{iaKey === 'trust' ? <TrustPage lang={lang} content={trustContent} /> : null}
				{iaKey !== 'facial' && iaKey !== 'corporal' && iaKey !== 'capilar' && iaKey !== 'trust' ? <h1 class:list={[bookingBlock && 'booking-page__title']}>{heading}</h1> : null}
				{iaKey !== 'facial' && iaKey !== 'corporal' && iaKey !== 'capilar' && iaKey !== 'trust' ? <p>{lead}</p> : null}
				{bookingBlock ? (
					<div class="booking-placeholder" data-booking-placeholder>
						<a
							class="booking-placeholder__primary"
							href={bookingCta.href}
							target={bookingCta.external ? '_blank' : undefined}
							rel={bookingCta.external ? 'noopener noreferrer' : undefined}
						>
							{bookingPlaceholderCta[lang].whatsapp}
						</a>
						<a class="booking-placeholder__secondary" href={href(lang, 'contact')}>
							{bookingPlaceholderCta[lang].contact}
						</a>
					</div>
				) : null}
			</>
		)
	}
</BaseLayout>
