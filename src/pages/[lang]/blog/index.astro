---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../../i18n/config';
import { blogIndexMeta } from '../../../i18n/blog-page';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const meta = blogIndexMeta[lang];
const all = await getCollection('blog');
const posts = all
	.filter((p) => p.id.startsWith(`${lang}/`))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout lang={lang} title={meta.title} description={meta.intro}>
	<h1>{meta.heading}</h1>
	<p>{meta.intro}</p>
	{
		posts.length === 0 ? (
			<p>
				{
					lang === 'es'
						? 'No hay articulos en este idioma todavia.'
						: lang === 'en'
							? 'No articles in this language yet.'
							: lang === 'ca'
								? 'Encara no hi ha articles en aquest idioma.'
								: "Pas encore d'articles dans cette langue."
				}
			</p>
		) : (
			<ul class="blog-list">
				{posts.map((post) => {
					const slug = post.id.split('/').pop()!;
					return (
						<li>
							<a href={`/${lang}/blog/${slug}/`}>{post.data.title}</a>
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString(lang === 'en' ? 'en-GB' : lang)}
							</time>
							<p>{post.data.description}</p>
						</li>
					);
				})}
			</ul>
		)
	}
</BaseLayout>
