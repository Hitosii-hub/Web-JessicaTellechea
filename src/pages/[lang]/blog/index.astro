---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogIndexPage from '../../../components/blog/BlogIndexPage.astro';
import { locales, type Locale } from '../../../i18n/config';
import { blogIndexMeta } from '../../../i18n/blog-page';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const meta = blogIndexMeta[lang];
---

<BaseLayout lang={lang} title={meta.title} description={meta.intro} shell="marketing">
	<BlogIndexPage lang={lang} />
</BaseLayout>
