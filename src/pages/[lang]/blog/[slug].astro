---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { Locale } from '../../../i18n/config';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => {
		const [lang, slug] = post.id.split('/');
		return { params: { lang, slug } };
	});
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug as string;
const post = await getEntry('blog', `${lang}/${slug}`);

if (!post || post.collection !== 'blog') {
	return Astro.redirect(`/${lang}/blog/`, 302);
}

const { Content } = await render(post);
const description = post.data.description;
---

<BaseLayout lang={lang} title={`${post.data.title} | Dra. Jessica Tellechea`} description={description}>
	<article>
		<h1>{post.data.title}</h1>
		<p>
			<time datetime={post.data.pubDate.toISOString()}>
				{post.data.pubDate.toLocaleDateString(lang === 'en' ? 'en-GB' : lang)}
			</time>
		</p>
		<p>{description}</p>
		<Content />
	</article>
</BaseLayout>
