---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../i18n/config';
import { legalPages } from '../../i18n/legal-copy';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const page = legalPages.privacidad[lang];
const description = page.paragraphs[0] ?? page.title;
---

<BaseLayout lang={lang} title={`WebAJ — ${page.title}`} description={description}>
	<article class="legal-prose">
		<h1>{page.title}</h1>
		{page.paragraphs.map((p) => <p>{p}</p>)}
	</article>
</BaseLayout>
