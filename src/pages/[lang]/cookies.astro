---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalDocArticle from '../../components/LegalDocArticle.astro';
import { locales, type Locale } from '../../i18n/config';
import { legalPages } from '../../i18n/legal-copy';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const page = legalPages.cookies[lang];
const description = page.sections[0]?.paragraphs[0] ?? page.title;
---

<BaseLayout lang={lang} title={`WebAJ — ${page.title}`} description={description}>
	<LegalDocArticle lang={lang} page={page} current="cookies" />
</BaseLayout>
