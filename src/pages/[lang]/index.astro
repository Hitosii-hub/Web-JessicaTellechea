---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../i18n/config';
import { pageStubsHome } from '../../i18n/page-stubs';
import CTAStack from '../../components/CTAStack.astro';
import heroUrl from '../../assets/hero-shape.svg?url';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const { title, heading, lead } = pageStubsHome[lang];
---

<BaseLayout lang={lang} title={title} description={lead}>
	<section class="hero">
		<div class="hero__inner">
			<div>
				<h1>{heading}</h1>
				<p>{lead}</p>
			</div>
			<div class="hero__visual">
				<img src={heroUrl} alt="" width="800" height="360" loading="eager" fetchpriority="high" />
			</div>
		</div>
	</section>
	<CTAStack lang={lang} />
</BaseLayout>
