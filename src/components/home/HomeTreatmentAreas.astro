---
import type { Locale } from '../../i18n/config';
import { homeContent } from '../../i18n/home-content';
import { href, type IaKey } from '../../i18n/route-registry';
import { corporalPublic } from '../../i18n/site-features';
import Heading from '../ui/Heading.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const c = homeContent[lang].specialties;

const allPillars: IaKey[] = ['facial', 'corporal', 'capilar'];
const visiblePillars = allPillars.filter((key) => key !== 'corporal' || corporalPublic);
const visibleCards = c.cards.filter((_, index) => visiblePillars.includes(allPillars[index]));
---

<section class="home-specialties">
	<div class="home-specialties__inner">
		<div class="home-specialties__head">
			<Heading level={2} serif>{c.h2}</Heading>
		</div>
		<div class="home-specialties__grid" data-pillar-count={visiblePillars.length}>
			{
				visibleCards.map((card, index) => (
					<a class="home-specialties__card" href={href(lang, visiblePillars[index])}>
						<div class="home-specialties__visual">
							<img
								class="home-specialties__image"
								src={card.imageSrc}
								alt={card.imageAlt}
								loading="lazy"
								decoding="async"
								width="640"
								height="800"
							/>
						</div>
						<div class="home-specialties__body">
							<span class="home-specialties__tag">{card.tag}</span>
							<h3 class="home-specialties__title">{card.title}</h3>
							<span class="home-specialties__link">{c.linkCta}</span>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>
