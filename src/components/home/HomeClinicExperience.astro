---
import type { Locale } from '../../i18n/config';
import { homeContent } from '../../i18n/home-content';
import Heading from '../ui/Heading.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const c = homeContent[lang].clinic;
---

<section class="home-clinic">
	<div class="home-clinic__inner">
		<div>
			<Heading level={2} serif>{c.h2}</Heading>
			<p class="home-clinic__lead">{c.lead}</p>
			<blockquote class="home-clinic__quote">{c.quote}</blockquote>
		</div>
		<div class="home-clinic__photos">
			<div class="home-clinic__photo" aria-hidden="true" />
			<div class="home-clinic__photo home-clinic__photo--offset" aria-hidden="true" />
		</div>
	</div>
</section>
