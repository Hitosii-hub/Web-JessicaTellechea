---
import type { Locale } from '../../i18n/config';
import { resolveBookingCta } from '../../i18n/booking-links';
import { homeContent } from '../../i18n/home-content';
import Heading from '../ui/Heading.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const c = homeContent[lang].finalCta;
const bookingCta = resolveBookingCta(lang);
---

<section class="home-final-cta">
	<div class="home-final-cta__inner">
	<Heading level={2} serif class="home-final-cta__title">{c.h2}</Heading>
		<style> 
			:global(.home-final-cta__title) 
				{ 
					font-size: clamp(2.15rem, 5vw, 2.85rem);
    				padding-bottom: 3%;
				} 
		</style>
		<p class="home-final-cta__body">{c.body}</p>
		<a
			class="home-final-cta__btn"
			href={bookingCta.href}
			target={bookingCta.external ? '_blank' : undefined}
			rel={bookingCta.external ? 'noopener noreferrer' : undefined}
		>{c.cta}</a>
	</div>
</section>

