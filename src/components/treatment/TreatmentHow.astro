---
import type { TreatmentPageContent } from '../../i18n/capilar-treatments/types';
import TreatmentImagePlaceholder from './TreatmentImagePlaceholder.astro';

interface Props {
	content: TreatmentPageContent;
}

const { content: c } = Astro.props;
---

<section class="treatment-section treatment-section--how">
	<div class="treatment-container treatment-split treatment-split--copy-left">
		<div class="treatment-split__visual">
			<TreatmentImagePlaceholder {...c.how.image} fillHeight />
		</div>
		<div class="treatment-split__copy">
			<h2 class="treatment-section__title">{c.how.title}</h2>
			{c.how.body.map((paragraph) => <p class="treatment-prose">{paragraph}</p>)}
			<div class="treatment-bullet-panel">
				<h3 class="treatment-bullet-panel__title">{c.how.benefitsTitle}</h3>
				<ul class="treatment-bullet-panel__list">
					{c.how.benefits.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</div>
		</div>
	</div>
</section>
