---
interface Props {
	cols?: '1' | '2' | '3';
	gap?: 'sm' | 'md' | 'lg';
	class?: string;
}

const { cols = '1', gap = 'md', class: className } = Astro.props;

const gaps = {
	sm: 'gap-[length:var(--space-sm)]',
	md: 'gap-[length:var(--space-md)]',
	lg: 'gap-[length:var(--space-lg)]',
} as const;

const colClasses = {
	'1': 'grid-cols-1',
	'2': 'grid-cols-1 sm:grid-cols-2',
	'3': 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
} as const;
---

<div class:list={['grid', colClasses[cols], gaps[gap], className]}>
	<slot />
</div>
