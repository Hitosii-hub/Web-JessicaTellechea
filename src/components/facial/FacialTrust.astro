---
interface Props {
  points: { title: string; body: string }[];
}

const { points } = Astro.props;
---

<section class="facial-section facial-section--trust">
  <div class="facial-container">
    <ul class="facial-points">
      {
        points.map((point) => (
          <li class="facial-points__item">
            <h3 class="facial-points__title">{point.title}</h3>
            <p class="facial-points__body">{point.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>


