---
import Heading from '../ui/Heading.astro';

interface Props {
  title: string;
  points: string[];
}

const { title, points } = Astro.props;
---

<section class="facial-section facial-section--trust">
  <div class="facial-container">
    <Heading level={2} serif class="facial-section__title">{title}</Heading>
    <ul class="facial-points">
      {
        points.map((point) => (
          <li class="facial-points__item">{point}</li>
        ))
      }
    </ul>
  </div>
</section>


