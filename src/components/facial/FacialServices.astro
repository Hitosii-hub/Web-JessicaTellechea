---
import Heading from '../ui/Heading.astro';

interface ServiceGroup {
  subtitle: string;
  services: string[];
}

interface ServiceImage {
  src: string;
  alt: string;
}

interface Props {
  groups: ServiceGroup[];
  images: ServiceImage[];
  id?: string;
  class?: string;
}

const { groups, images, id, class: className } = Astro.props;
---

<section id={id} class:list={['facial-section', 'facial-section--services', className]}>
  <div class="facial-container">
    <div class="facial-services">
      {
        groups.map((group) => (
          <div class="facial-services__group">
            <Heading level={3} serif class="facial-services__subtitle">{group.subtitle}</Heading>
            <ul class="facial-services__list">
              {group.services.map((service) => <li>{service}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="facial-services__gallery">
      {
        images.map((image) => (
          <img class="facial-services__image" src={image.src} alt={image.alt} width={720} height={720} loading="lazy" decoding="async" />
        ))
      }
    </div>
  </div>
</section>

