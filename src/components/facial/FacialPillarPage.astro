---
import type { Locale } from '../../i18n/config';
import type { FacialPageContent } from '../../i18n/facial-page';
import FinalCta from '../FinalCta.astro';
import FacialBenefits from './FacialBenefits.astro';
import FacialHero from './FacialHero.astro';
import FacialInsight from './FacialInsight.astro';
import FacialMedicalApproach from './FacialMedicalApproach.astro';
import FacialProcess from './FacialProcess.astro';
import FacialServices from './FacialServices.astro';
import FacialTrust from './FacialTrust.astro';
import { resolveBookingCta } from '../../i18n/booking-links';

interface Props {
  lang: Locale;
  content: FacialPageContent;
}

const { lang, content } = Astro.props;
const bookingCta = resolveBookingCta(lang);
---

<div class="facial-page">
  <FacialHero
    lang={lang}
    eyebrow={content.hero.eyebrow}
    h1={content.hero.h1}
    subtitle={content.hero.subtitle}
    lead={content.hero.lead}
    primaryCta={content.hero.primaryCta}
    secondaryCta={content.hero.secondaryCta}
    imageSrc={content.hero.imageSrc}
    imageAlt={content.hero.imageAlt}
  />
  <FacialInsight title={content.insight.title} body={content.insight.body} />
  <FacialMedicalApproach
    eyebrow={content.medicalApproach.eyebrow}
    title={content.medicalApproach.title}
    body={content.medicalApproach.body}
    imageSrc={content.medicalApproach.imageSrc}
    imageAlt={content.medicalApproach.imageAlt}
  />
  <FacialBenefits title={content.benefits.title} items={content.benefits.items} />
  <FacialServices groups={content.services.groups} images={content.services.images} />
  <FacialProcess eyebrow={content.process.eyebrow} steps={content.process.steps} />
  <FacialTrust points={content.trust.points} />
  <section class="facial-section facial-section--final-cta">
    <div class="facial-container">
      <FinalCta
        lang={lang}
        h2={content.finalCta.h2}
        body={content.finalCta.body}
        cta={content.finalCta.primary}
        primaryHref={bookingCta.href}
        primaryExternal={bookingCta.external}
      />
    </div>
  </section>
</div>

