---
interface Props {
  eyebrow: string;
  steps: { title: string; body: string }[];
}

const { eyebrow, steps } = Astro.props;
---

<section class="facial-section facial-section--process">
  <div class="facial-container">
    <p class="facial-eyebrow facial-eyebrow--center">{eyebrow}</p>
    <ol class="facial-process">
      {
        steps.map((step, index) => (
          <li class="facial-process__step">
            <span class="facial-process__index">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="facial-process__title">{step.title}</h3>
            <p class="facial-process__body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>


