---
import Heading from '../ui/Heading.astro';

interface Props {
  eyebrow: string;
  title: string;
  body: string[];
  imageSrc: string;
  imageAlt: string;
  id?: string;
  class?: string;
}

const { eyebrow, title, body, imageSrc, imageAlt, id, class: className } = Astro.props;
---

<section id={id} class:list={['facial-section', 'facial-section--medical-approach', className]}>
  <div class="facial-container facial-medical-approach">
    <div class="facial-medical-approach__content">
      <p class="facial-eyebrow facial-eyebrow--left">{eyebrow}</p>
      <Heading level={2} serif class="facial-section__title facial-section__title--left">{title}</Heading>
      {body.map((paragraph) => <p class="facial-medical-approach__body">{paragraph}</p>)}
    </div>
    <figure class="facial-medical-approach__visual">
      <img src={imageSrc} alt={imageAlt} width={720} height={960} loading="lazy" decoding="async" />
    </figure>
  </div>
</section>

