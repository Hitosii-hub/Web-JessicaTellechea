---
import Heading from '../ui/Heading.astro';

interface Props {
  title: string;
  items: string[];
}

const { title, items } = Astro.props;
---

<section class="facial-section facial-section--benefits">
  <div class="facial-container">
    <Heading level={2} serif class="facial-section__title">{title}</Heading>
    <ul class="facial-benefits-list">
      {
        items.map((item) => (
          <li class="facial-benefits-list__item">{item}</li>
        ))
      }
    </ul>
  </div>
</section>


