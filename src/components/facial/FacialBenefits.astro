---
import Heading from '../ui/Heading.astro';

interface Props {
  title: string;
  items: { icon: string; title: string; body: string }[];
}

const { title, items } = Astro.props;
---

<section class="facial-section facial-section--benefits">
  <div class="facial-container">
    <Heading level={2} serif class="facial-section__title">{title}</Heading>
    <div class="facial-benefits-texture" aria-hidden="true"></div>
    <ul class="facial-benefits-list">
      {
        items.map((item) => (
          <li class="facial-benefits-list__item">
            <i class:list={['ph-thin', item.icon, 'facial-benefits-list__icon']} aria-hidden="true"></i>
            <h3 class="facial-benefits-list__title">{item.title}</h3>
            <p class="facial-benefits-list__body">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>


