---
import type { Locale } from '../../i18n/config';
import type { TrustPageContent } from '../../i18n/trust-page';
import { href } from '../../i18n/route-registry';
import Heading from '../ui/Heading.astro';

interface Props {
	lang: Locale;
	content: TrustPageContent;
}

const { lang, content } = Astro.props;
const whatsapp = import.meta.env.PUBLIC_WHATSAPP_E164?.trim();
const whatsappHref = whatsapp ? `https://wa.me/${whatsapp}` : href(lang, 'contact');

const principleIcons = ['ph-leaf', 'ph-shield-check', 'ph-chart-line-up'] as const;
---

<article class="trust-page">
	<section class="trust-hero">
		<div class="trust-hero__media" aria-hidden="true">
			<img
				class="trust-hero__image"
				src={content.hero.imageSrc}
				alt={content.hero.imageAlt}
				width={1280}
				height={960}
				loading="eager"
				decoding="async"
				fetchpriority="high"
			/>
			<div class="trust-hero__overlay"></div>
		</div>
		<div class="trust-hero__inner">
			<p class="trust-eyebrow">{content.hero.eyebrow}</p>
			<h1 class="trust-hero__title">{content.hero.h1}</h1>
			<p class="trust-hero__subtitle">{content.hero.subtitle}</p>
			<p class="trust-hero__text">{content.hero.text}</p>
			<a class="trust-hero__cta" href={href(lang, 'contact')}>{content.hero.cta}</a>
		</div>
	</section>

	<section class="trust-section trust-section--meaning">
		<div class="trust-container trust-meaning">
			<div class="trust-meaning__rule" aria-hidden="true"></div>
			<p class="trust-eyebrow">{content.meaning.eyebrow}</p>
			<Heading level={2} serif class="trust-meaning__title">{content.meaning.h2}</Heading>
			<div class="trust-meaning__body">
				{content.meaning.text.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>
	</section>

	<section class="trust-section trust-section--valuation">
		<div class="trust-container">
			<div class="trust-valuation__head">
				<div class="trust-valuation__copy">
					<Heading level={2} serif class="trust-section__title trust-section__title--left">
						{content.valuation.h2}
					</Heading>
					<p class="trust-valuation__body">{content.valuation.intro}</p>
				</div>
				<p class="trust-valuation__eyebrow">{content.valuation.eyebrow}</p>
			</div>
			<ol class="trust-protocol">
				{
					content.valuation.steps.map((step, index) => (
						<li class="trust-protocol__card">
							<span class="trust-protocol__index">{String(index + 1).padStart(2, '0')}</span>
							<h3 class="trust-protocol__title">{step.title}</h3>
							<p class="trust-protocol__body">{step.body}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="trust-section trust-section--consultation">
		<div class="trust-container trust-consultation">
			<div class="trust-consultation__copy">
				<p class="trust-eyebrow">{content.consultation.eyebrow}</p>
				<Heading level={2} serif class="trust-section__title trust-section__title--left">
					{content.consultation.h2}
				</Heading>
				<p class="trust-valuation__body">{content.consultation.intro}</p>
				<ul class="trust-pillars">
					{
						content.consultation.items.map((pillar) => (
							<li class="trust-pillars__item">
								<div>
									<h3 class="trust-pillars__title">{pillar.title}</h3>
									<p class="trust-pillars__body">{pillar.body}</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section class="trust-section trust-section--principles" aria-labelledby="trust-principles-heading">
		<div class="trust-container trust-principles">
			<div class="trust-principles__intro">
				<p class="trust-eyebrow trust-principles__eyebrow">{content.principles.eyebrow}</p>
				<Heading level={2} serif id="trust-principles-heading" class="trust-principles__title">
					{content.principles.h2}
				</Heading>
			</div>
			<ol class="trust-principles__list">
				{
					content.principles.items.map((item, index) => (
						<li class="trust-principles__item">
							<span class="trust-principles__connector" aria-hidden="true" />
							<div class="trust-principles__card">
								<div class="trust-principles__icon-ring" aria-hidden="true">
									<i
										class:list={[
											'ph-thin',
											principleIcons[index] ?? 'ph-circle',
											'trust-principles__icon',
										]}
									/>
								</div>
								<h3 class="trust-principles__item-title">{item.title}</h3>
								<p class="trust-principles__item-body">{item.body}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="trust-section trust-section--final-cta">
		<div class="trust-container trust-final">
			<p class="trust-eyebrow trust-final__eyebrow">{content.finalCta.eyebrow}</p>
			<Heading level={2} serif class="trust-final__title">{content.finalCta.h2}</Heading>
			<p class="trust-final__text">{content.finalCta.text}</p>
			<div class="trust-final__actions">
				<a class="trust-final__primary" href={href(lang, 'contact')}>{content.finalCta.cta}</a>
				<a class="trust-final__secondary" href={whatsappHref}>{content.finalCta.secondaryCta}</a>
			</div>
		</div>
	</section>
</article>
