---
import type { Locale } from '../i18n/config';
import { resolveBookingCta } from '../i18n/booking-links';
import Heading from './ui/Heading.astro';

interface Props {
	lang: Locale;
	h2: string;
	body?: string;
	cta: string;
	primaryHref?: string;
	primaryExternal?: boolean;
	secondaryActions?: { label: string; href: string }[];
}

const { lang, h2, body, cta, primaryHref, primaryExternal, secondaryActions = [] } = Astro.props;
const fallback = resolveBookingCta(lang);
const effectiveHref = primaryHref ?? fallback.href;
const effectiveExternal = primaryHref !== undefined ? primaryExternal === true : fallback.external;
---

<section class="home-final-cta">
	<div class="home-final-cta__inner">
		<Heading level={2} serif class="home-final-cta__title">{h2}</Heading>
		{body ? <p class="home-final-cta__body">{body}</p> : null}
		<a
			class="home-final-cta__btn"
			href={effectiveHref}
			target={effectiveExternal ? '_blank' : undefined}
			rel={effectiveExternal ? 'noopener noreferrer' : undefined}
		>{cta}</a>
		{
			secondaryActions.length ? (
				<div class="home-final-cta__secondary">
					{secondaryActions.map((action) => (
						<a class="home-final-cta__secondary-link" href={action.href}>
							{action.label}
						</a>
					))}
				</div>
			) : null
		}
	</div>
</section>
