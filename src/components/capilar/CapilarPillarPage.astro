---
import type { Locale } from '../../i18n/config';
import type { CapilarPageContent } from '../../i18n/capilar-page';
import { resolveBookingCta } from '../../i18n/booking-links';
import { href, hrefCapilarTreatment } from '../../i18n/route-registry';
import FinalCta from '../FinalCta.astro';
import Heading from '../ui/Heading.astro';

interface Props {
	lang: Locale;
	content: CapilarPageContent;
}

const { lang, content } = Astro.props;
const bookingCta = resolveBookingCta(lang);
---

<article class="capilar-page">
	<section class="capilar-hero">
		<div class="capilar-hero__media" aria-hidden="true">
			<img
				class="capilar-hero__image"
				src={content.hero.imageSrc}
				alt={content.hero.imageAlt}
				width={1280}
				height={960}
				loading="eager"
				decoding="async"
				fetchpriority="high"
			/>
			<div class="capilar-hero__overlay"></div>
		</div>
		<div class="capilar-hero__inner">
			<p class="capilar-eyebrow">{content.hero.eyebrow}</p>
			<h1 class="capilar-hero__title">{content.hero.h1}</h1>
			<p class="capilar-hero__subtitle">{content.hero.subtitle}</p>
			<p class="capilar-hero__text">{content.hero.text}</p>
			<div class="capilar-hero__actions">
				<a
					class="capilar-hero__primary"
					href={bookingCta.href}
					target={bookingCta.external ? '_blank' : undefined}
					rel={bookingCta.external ? 'noopener noreferrer' : undefined}
				>{content.hero.primaryCta}</a>
				<a class="capilar-hero__secondary" href={href(lang, 'trust')}>{content.hero.secondaryCta}</a>
			</div>
		</div>
	</section>

	<section class="capilar-section capilar-section--identification">
		<div class="capilar-container capilar-identification">
			<div class="capilar-identification__rule" aria-hidden="true"></div>
			<Heading level={2} serif class="capilar-identification__title">{content.identification.title}</Heading>
			{
				content.identification.body.map((paragraph) => (
					<p class="capilar-identification__body">{paragraph}</p>
				))
			}
		</div>
	</section>

	<section class="capilar-section capilar-section--diagnosis">
		<div class="capilar-texture" aria-hidden="true"></div>
		<div class="capilar-container capilar-diagnosis">
			<div class="capilar-diagnosis__copy">
				<p class="capilar-eyebrow">{content.diagnosis.eyebrow}</p>
				<Heading level={2} serif class="capilar-section__title capilar-section__title--left">
					{content.diagnosis.title}
				</Heading>
				{content.diagnosis.body.map((paragraph) => <p class="capilar-diagnosis__body">{paragraph}</p>)}
			</div>
			<figure class="capilar-diagnosis__visual">
				<img
					src={content.diagnosis.imageSrc}
					alt={content.diagnosis.imageAlt}
					width={720}
					height={960}
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="capilar-section capilar-section--benefits">
		<div class="capilar-container">
			<Heading level={2} serif class="capilar-section__title">
				{content.benefitsTitle}
			</Heading>
			<ol class="capilar-benefits">
				{
					content.benefits.map((benefit) => (
						<li class="capilar-benefits__item">
							<i class:list={['ph-thin', benefit.icon, 'capilar-benefits__icon']} aria-hidden="true"></i>
							<h3 class="capilar-benefits__title">{benefit.title}</h3>
							<p class="capilar-benefits__body">{benefit.body}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="capilar-section capilar-section--treatments">
		<div class="capilar-container">
			<div class="capilar-treatments">
				<div class="capilar-treatments__head">
					<Heading level={2} serif class="capilar-section__title capilar-section__title--left">
						{content.treatments.title}
					</Heading>
				</div>
				<div class="capilar-treatments__grid" data-treatment-count={content.treatments.items.length}>
					{
						content.treatments.items.map((item, index) => (
							<a
								class="capilar-treatment-card"
								href={hrefCapilarTreatment(lang, item.treatmentKey)}
								data-treatment-key={item.treatmentKey}
							>
								<div class="capilar-treatment-card__visual">
									<img
										class:list={[
											'capilar-treatment-card__image',
											item.treatmentKey === 'mesoterapia-capilar' &&
												'capilar-treatment-card__image--silent-luxury',
										]}
										src={item.imageSrc}
										alt={item.imageAlt}
										width={640}
										height={480}
										loading={index < 2 ? 'eager' : 'lazy'}
										decoding="async"
										fetchpriority={index === 0 ? 'high' : undefined}
									/>
								</div>
								<div class="capilar-treatment-card__body">
									<span class="capilar-treatment-card__tag">{item.tag}</span>
									<h3 class="capilar-treatment-card__title">{item.title}</h3>
									<p class="capilar-treatment-card__excerpt">{item.body}</p>
									<span class="capilar-treatment-card__link">{content.treatments.linkCta}</span>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section class="capilar-section capilar-section--process">
		<div class="capilar-container">
			<Heading level={2} serif class="capilar-section__title">{content.process.title}</Heading>
			<ol class="capilar-process">
				{
					content.process.steps.map((step, index) => (
						<li class="capilar-process__step">
							<span class="capilar-process__ghost">{index + 1}</span>
							<h3 class="capilar-process__title">{step.title}</h3>
							<p class="capilar-process__body">{step.body}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="capilar-section capilar-section--authority">
		<div class="capilar-container capilar-authority">
			<figure class="capilar-authority__visual">
				<img
					src={content.authority.imageSrc}
					alt={content.authority.imageAlt}
					width={720}
					height={960}
					loading="lazy"
					decoding="async"
				/>
			</figure>
			<div class="capilar-authority__copy">
				<Heading level={2} serif class="capilar-authority__title">{content.authority.title}</Heading>
				<ul class="capilar-authority__list">
					{
						content.authority.items.map((item) => (
							<li class="capilar-authority__item">
								<i class:list={['ph-thin', item.icon, 'capilar-authority__icon']} aria-hidden="true"></i>
								<div>
									<h3 class="capilar-authority__item-title">{item.title}</h3>
									<p class="capilar-authority__body">{item.body}</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section class="capilar-section capilar-section--final-cta">
		<div class="capilar-container">
			<FinalCta
				lang={lang}
				h2={content.finalCta.h2}
				body={content.finalCta.body}
				cta={content.finalCta.primary}
				primaryHref={bookingCta.href}
				primaryExternal={bookingCta.external}
			/>
		</div>
	</section>
</article>
