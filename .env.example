# Copy to `.env` and adjust. Read at build/dev time for Astro `site` (canonical, hreflang).
# No trailing slash required.
SITE_URL=http://localhost:4321

# CLINIC INFORMATION
PUBLIC_CLINIC_ADDRESS="123 Main St, Anytown, USA"
PUBLIC_CLINIC_PHONE="+34 600111222"
PUBLIC_CLINIC_EMAIL="info@acme.com"
PUBLIC_CLINIC_WEBSITE="https://clinic.com"
PUBLIC_CLINIC_INSTAGRAM="https://instagram.com/clinic"
PUBLIC_GOOGLE_MAPS_URL="https://maps.app.goo.gl/1234567890"

# Optional studio credit link in footer (Umbral)
# PUBLIC_STUDIO_URL=https://umbral.example

# WA.ME LINK (E.164, No symbols)
PUBLIC_WHATSAPP_E164=34600111222

# URL de destino POST del formulario (Formspree, Getform, etc.)
# Si se deja vacío, los formularios usan FormSubmit.co hacia PUBLIC_CLINIC_EMAIL.
PUBLIC_FORM_POST_URL=https://form.placeholder.com

# LEGAL PROSE
PUBLIC_LEGAL_CONTROLLER_NAME="ACME INC"
PUBLIC_LEGAL_CONTROLLER_NIF="123456789A"
PUBLIC_LEGAL_CONTROLLER_ADDRESS="123 Main St, Anytown, USA"
PUBLIC_LEGAL_CONTROLLER_EMAIL="info@acme.com"
PUBLIC_LEGAL_DPO_EMAIL="dpo@acme.com"

# BOOKING COMPONENT / NUBIMED PROVIDER 
PUBLIC_NUBIMED_CLINICA_ID=123
PUBLIC_NUBIMED_VENDOR_ORIGIN=https://portal.clinicaenlanube.com
# Opcional: proxy mismo-origen hacia el portal (produccion: worker en tu dominio). En dev, si lo dejas vacio,
# la isla usa automaticamente http://<host>:<puerto>/__nubimed-proxy (Vite en astro.config.mjs).
# PUBLIC_NUBIMED_PROXY_URL=http://localhost:4321/__nubimed-proxy
# Si el dev server muestra "504 Outdated Optimize Dep": parar dev, borrar carpeta node_modules/.vite, reiniciar npm run dev.
# PUBLIC_NUBIMED_PROXY_URL=http://localhost:4321/__nubimed-proxy
# Si el gate falla: URL del portal /new para enlace de degradacion.
PUBLIC_NUBIMED_PORTAL_NEW_URL=https://portal.clinicaenlanube.com/clinicas/123/cita_peticiones/new